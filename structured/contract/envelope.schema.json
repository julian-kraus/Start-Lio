{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex extraction envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "doc_kind",
    "doc_kind_confidence",
    "languages",
    "spec_version",
    "extracted_by",
    "doc_date",
    "facts",
    "unreadable",
    "proposed_fact_types"
  ],
  "properties": {
    "source": {
      "type": "object"
    },
    "doc_kind": {
      "type": "string"
    },
    "doc_kind_confidence": {
      "type": "string"
    },
    "languages": {
      "type": "array"
    },
    "spec_version": {
      "type": "string"
    },
    "extracted_by": {
      "type": "string"
    },
    "doc_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "facts": {
      "type": "array"
    },
    "unreadable": {
      "type": "array"
    },
    "proposed_fact_types": {
      "type": "array"
    }
  }
}
