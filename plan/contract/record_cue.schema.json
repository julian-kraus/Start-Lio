{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lookahead.local/plan/contract/record_cue.schema.json",
  "title": "record_cue",
  "description": "Lookahead record kind 'cue': a rehearsal beat boundary, never shown.",
  "type": "object",
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "const": "cue"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "wait_for": {
      "type": "string",
      "pattern": "^(goal|accept:.+)$"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "description": "Where a number comes from: a kb fact id, a goal line, a labelled scenario input or a file.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "fact_id": {
              "type": [
                "string",
                "integer"
              ]
            },
            "goal_line": {
              "type": "string",
              "minLength": 1
            },
            "scenario_input": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "value": {}
          }
        }
      ]
    }
  }
}
