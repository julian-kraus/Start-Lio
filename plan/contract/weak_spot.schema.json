{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lookahead.local/plan/contract/weak_spot.schema.json",
  "title": "weak_spot",
  "description": "One ranked part that can break the goal, output of the sourcing ranking.",
  "type": "object",
  "required": [
    "part_id",
    "rank",
    "reason",
    "sources"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "part_id": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "minLength": 1
    },
    "rank": {
      "type": "integer",
      "minimum": 1
    },
    "p_fail": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "exposure_eur": {
      "type": "number",
      "minimum": 0
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "detail": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "description": "Where a number comes from: a kb fact id, a goal line, a labelled scenario input or a file.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "fact_id": {
              "type": [
                "string",
                "integer"
              ]
            },
            "goal_line": {
              "type": "string",
              "minLength": 1
            },
            "scenario_input": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "value": {}
          }
        }
      ]
    }
  }
}
