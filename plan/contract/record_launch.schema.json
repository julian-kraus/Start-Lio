{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lookahead.local/plan/contract/record_launch.schema.json",
  "title": "record_launch",
  "description": "Lookahead record kind 'launch': the launch the timeline is about.",
  "type": "object",
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "const": "launch"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "live",
        "rehearse"
      ]
    },
    "site": {
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "pack_windows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "goal_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "q"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "q": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "description": "Where a number comes from: a kb fact id, a goal line, a labelled scenario input or a file.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "fact_id": {
              "type": [
                "string",
                "integer"
              ]
            },
            "goal_line": {
              "type": "string",
              "minLength": 1
            },
            "scenario_input": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "value": {}
          }
        }
      ]
    }
  }
}
