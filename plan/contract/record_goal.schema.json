{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lookahead.local/plan/contract/record_goal.schema.json",
  "title": "record_goal",
  "description": "Lookahead record kind 'goal': the goal and risk appetite from the interview.",
  "type": "object",
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "const": "goal"
    },
    "statement": {
      "type": "string",
      "description": "Empty when the interview has no 'goal' answer."
    },
    "answers": {
      "type": [
        "object",
        "array"
      ],
      "description": "The app writes an object keyed by question id; a list is accepted as well."
    },
    "unit_loss_eur": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "budget_cap_eur": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "budget_eur": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "The name the goal interview writes for budget_cap_eur; consumers read either."
    },
    "sacrifices": {
      "type": "array"
    },
    "edition": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "description": "Where a number comes from: a kb fact id, a goal line, a labelled scenario input or a file.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "fact_id": {
              "type": [
                "string",
                "integer"
              ]
            },
            "goal_line": {
              "type": "string",
              "minLength": 1
            },
            "scenario_input": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "value": {}
          }
        }
      ]
    }
  }
}
