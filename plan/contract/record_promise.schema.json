{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lookahead.local/plan/contract/record_promise.schema.json",
  "title": "record_promise",
  "description": "Lookahead record kind 'promise': a watched supplier promise; upsert by promise_id.",
  "type": "object",
  "required": [
    "kind",
    "promise_id"
  ],
  "properties": {
    "kind": {
      "const": "promise"
    },
    "promise_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "waiting",
        "proven",
        "broken",
        "cancelled"
      ]
    },
    "supplier_id": {
      "type": "string",
      "minLength": 1
    },
    "due": {
      "type": "string",
      "format": "date-time"
    },
    "next_check": {
      "type": "string",
      "format": "date-time"
    },
    "proven_at": {
      "type": "string",
      "format": "date-time"
    },
    "broken_at": {
      "type": "string",
      "format": "date-time"
    },
    "what": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "description": "Where a number comes from: a kb fact id, a goal line, a labelled scenario input or a file.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "fact_id": {
              "type": [
                "string",
                "integer"
              ]
            },
            "goal_line": {
              "type": "string",
              "minLength": 1
            },
            "scenario_input": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "value": {}
          }
        }
      ]
    }
  }
}
