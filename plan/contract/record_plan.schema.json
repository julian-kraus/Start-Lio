{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lookahead.local/plan/contract/record_plan.schema.json",
  "title": "record_plan",
  "description": "Lookahead record kind 'plan': the latest solve; it replaces the previous one.",
  "type": "object",
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "const": "plan"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lane_id"
        ],
        "properties": {
          "lane_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "need": {
            "type": "number"
          },
          "usable": {
            "type": "number"
          },
          "gap": {
            "type": "number"
          },
          "needed_by": {
            "type": "string",
            "format": "date-time"
          },
          "bars": {
            "type": "array"
          }
        }
      }
    },
    "coverage": {
      "$ref": "https://lookahead.local/plan/contract/coverage.schema.json"
    },
    "summary": {}
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "description": "Where a number comes from: a kb fact id, a goal line, a labelled scenario input or a file.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "fact_id": {
              "type": [
                "string",
                "integer"
              ]
            },
            "goal_line": {
              "type": "string",
              "minLength": 1
            },
            "scenario_input": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "value": {}
          }
        }
      ]
    }
  }
}
