{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lookahead.local/plan/contract/record_decision.schema.json",
  "title": "record_decision",
  "description": "Lookahead record kind 'decision': a decision card or its outcome; upsert by decision_id.",
  "type": "object",
  "required": [
    "kind",
    "decision_id"
  ],
  "properties": {
    "kind": {
      "const": "decision"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "open",
        "accepted",
        "rejected",
        "expired",
        "superseded"
      ]
    },
    "decided_by": {
      "type": "string",
      "minLength": 1
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "signer": {
      "type": "object"
    },
    "options": {
      "type": "array"
    },
    "on_accept": {
      "type": "array"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "description": "Where a number comes from: a kb fact id, a goal line, a labelled scenario input or a file.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "fact_id": {
              "type": [
                "string",
                "integer"
              ]
            },
            "goal_line": {
              "type": "string",
              "minLength": 1
            },
            "scenario_input": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "value": {}
          }
        }
      ]
    }
  }
}
