{
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Read(./secrets/**)",
      "Read(**/secrets/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(*secrets/*)",
      "Bash(*supabase.env*)",
      "Bash(*anthropic.env*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git reset --hard*)",
      "Bash(git branch -D *)",
      "Bash(gh repo delete*)",
      "Bash(gh issue delete*)",
      "Bash(python -m mail send*)",
      "Bash(python -m mail approve*)",
      "Bash(*MAIL_SEND_MODE=*)"
    ]
  }
}
